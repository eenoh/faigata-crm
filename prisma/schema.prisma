datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Team {
  id         Int         @id @default(autoincrement())
  name       String
  // later: ownerId, timezone, etc.

  leadFields LeadField[]
}

model LeadField {
  id      Int           @id @default(autoincrement())
  teamId  Int
  team    Team          @relation(fields: [teamId], references: [id])

  key     String        // internal key like "industry"
  label   String        // UI label like "Industry"
  type    LeadFieldType
  options String[]      @default([])  // for dropdowns
  order   Int           // display order

  @@unique([teamId, key])
}

enum LeadFieldType {
  text
  number
  select
  boolean
}

model Lead {
  id            Int      @id @default(autoincrement())
  teamId        Int
  campaignId    Int?
  name          String
  company       String?
  stage         String
  customValues  Json     // ← stores dynamic fields like { industry: "SaaS", region: "EU" }

  createdAt     DateTime @default(now())

  team          Team     @relation(fields: [teamId], references: [id])
  campaign      Campaign @relation(fields: [campaignId], references: [id])
}
